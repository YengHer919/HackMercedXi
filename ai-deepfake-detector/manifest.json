{
  "manifest_version": 3,
  "name": "AI Deepfake Detector",
  "version": "1.0",
  "description": "Detects AI-generated or deepfake images on social media and provides context.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.instagram.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.realitydefender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deepfake Detector"
  }
}
